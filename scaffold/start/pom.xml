<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>example-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <!-- The deployable: every context's infrastructure and adapter modules, the persimmon starters, configuration and the end-to-end tests. -->
  <artifactId>example-app-start</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>ordering-infrastructure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>ordering-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- contexts -->
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-outbox</artifactId>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-tenancy</artifactId>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-idempotency</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <!-- Add flyway-database-postgresql or flyway-mysql with the matching driver. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Swap for the PostgreSQL or MySQL driver and point spring.datasource at it. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-archunit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
