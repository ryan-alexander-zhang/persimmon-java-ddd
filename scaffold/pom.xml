<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.10</version>
    <relativePath/>
  </parent>

  <!--
    A modular monolith. Each bounded context is a directory of five modules, one per layer:
    domain -> nothing; api -> nothing; application -> domain, api; infrastructure and adapter ->
    application. A context may depend on another context's -api module only. start assembles
    every context into one deployable; a context that moves to its own service takes its directory
    and gets a start of its own. The module graph enforces the arrows at compile time; the ArchUnit
    test in start checks the rules inside the packages. persimmon new with the context flag adds one.
  -->
  <groupId>com.example</groupId>
  <artifactId>example-app</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>example-app</name>
  <description>A persimmon-ddd application: bounded contexts side by side, each one module per layer, any of them ready to leave.</description>

  <modules>
    <module>ordering</module>
    <!-- contexts -->
    <module>start</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <persimmon-ddd.version>0.1.0-SNAPSHOT</persimmon-ddd.version>
    <mybatis-plus.version>3.5.15</mybatis-plus.version>
  </properties>

  <!-- persimmon-ddd is on GitHub Packages, which needs a GitHub token even to read: a server with
       id "github" in ~/.m2/settings.xml (username + a PAT with read:packages). See README.md. -->
  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/ryan-alexander-zhang/persimmon-java-ddd</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-bom</artifactId>
        <version>${persimmon-ddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-bom</artifactId>
        <version>${mybatis-plus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
