<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.10</version>
    <relativePath/>
  </parent>

  <!--
    One bounded context, one Maven module per layer. The module graph is the dependency rule:
    domain -> nothing; api -> nothing; application -> domain, api; infrastructure and adapter ->
    application; start -> all of them. A layer that is not on a module's classpath cannot be
    imported, and the ArchUnit test in start checks the finer rules inside the packages.
  -->
  <groupId>com.example</groupId>
  <artifactId>ordering-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ordering-service</name>
  <description>A persimmon-ddd service: one bounded context, one module per layer.</description>

  <modules>
    <module>ordering-domain</module>
    <module>ordering-api</module>
    <module>ordering-application</module>
    <module>ordering-infrastructure</module>
    <module>ordering-adapter</module>
    <module>ordering-start</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <persimmon-ddd.version>0.1.0-SNAPSHOT</persimmon-ddd.version>
    <mybatis-plus.version>3.5.15</mybatis-plus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-bom</artifactId>
        <version>${persimmon-ddd.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-bom</artifactId>
        <version>${mybatis-plus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
