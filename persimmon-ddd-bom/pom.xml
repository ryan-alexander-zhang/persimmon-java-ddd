<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.persimmon.ddd</groupId>
  <artifactId>persimmon-ddd-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>persimmon-ddd-bom</name>
  <description>Import this to get one version for every persimmon-ddd module. It manages nothing else.</description>

  <!-- No parent on purpose (an importable BOM carries no build), so the publishing target is repeated here. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/ryan-alexander-zhang/persimmon-java-ddd</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <url>https://maven.pkg.github.com/ryan-alexander-zhang/persimmon-java-ddd</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-persistence-mybatis-plus</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-outbox</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-flyway</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-openapi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-tenancy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-idempotency</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-rabbit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.persimmon.ddd</groupId>
        <artifactId>persimmon-ddd-archunit</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
