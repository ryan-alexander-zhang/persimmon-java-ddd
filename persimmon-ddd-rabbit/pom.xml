<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.persimmon.ddd</groupId>
    <artifactId>persimmon-ddd-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- RabbitMQ as the transport of routed integration events: the outbox relay publishes, the bridge consumes into the same listeners. -->
  <artifactId>persimmon-ddd-rabbit</artifactId>
  <name>persimmon-ddd-rabbit</name>
  <description>Publishes routed outbox rows to a RabbitMQ topic exchange as CloudEvents-style messages and consumes such messages from a queue into the local integration event listeners.</description>

  <dependencies>
    <dependency>
      <groupId>com.persimmon.ddd</groupId>
      <artifactId>persimmon-ddd-outbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- The round-trip test runs against a real broker in Docker and is skipped where there is none. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
